---
import PublicLayout from '@/layouts/PublicLayout.astro';
import { vehiclesData } from '@/data/vehiclesData.generated';

const featured = vehiclesData.filter((vehicle) => vehicle.status === 'available').slice(0, 6);
---

<PublicLayout
  title="Automobile Quick | Gebrauchtwagen in Iserlohn-Letmathe"
  description="Automobile Quick in Iserlohn-Letmathe: Gebrauchtwagen entdecken, Fahrzeugankauf anfragen und Finanzierung persönlich besprechen."
  canonicalPath="/"
>
  <section class="relative isolate min-h-[min(780px,calc(100svh-72px))] overflow-hidden bg-primary text-white">
    <img
      src="/images/hero-bg.jpg"
      alt="Automobile Quick Fahrzeugpräsentation"
      class="absolute inset-0 -z-20 h-full w-full object-cover"
      width="1600"
      height="900"
      fetchpriority="high"
    />
    <div class="hero-scrim absolute inset-0 -z-10"></div>

    <div class="section-wrap flex min-h-[min(780px,calc(100svh-72px))] items-center py-16 sm:py-20 lg:py-24">
      <div class="max-w-3xl">
        <p class="eyebrow">Automobile Quick · Iserlohn-Letmathe</p>
        <h1 class="mt-5 text-4xl font-black leading-[1.02] tracking-[-0.035em] text-white sm:text-5xl lg:text-7xl">
          Gebrauchtwagen, die schnell überzeugen.
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-white/88 sm:text-xl">
          Große Fahrzeugbilder, klare Daten und direkte Wege zur persönlichen Beratung — ohne Shop-Hürden und ohne unnötige Schritte.
        </p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a href="/fahrzeuge/" class="btn-premium-secondary sm:min-w-48">Fahrzeuge ansehen</a>
          <a href="/kontakt?topic=appointment" class="btn-header-secondary sm:min-w-48">Besichtigung anfragen</a>
        </div>

        <div class="mt-10 grid max-w-3xl grid-cols-2 gap-x-6 gap-y-5 border-t border-white/20 pt-7 text-sm sm:grid-cols-4">
          <div><p class="font-black text-white">Regional</p><p class="mt-1 text-white/70">Iserlohn-Letmathe</p></div>
          <div><p class="font-black text-white">Direkt</p><p class="mt-1 text-white/70">Persönliche Anfrage</p></div>
          <div><p class="font-black text-white">Transparent</p><p class="mt-1 text-white/70">Klare Fahrzeugdaten</p></div>
          <div><p class="font-black text-white">Mobil</p><p class="mt-1 text-white/70">Schnelle Kontaktwege</p></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-wrap py-14 sm:py-18 lg:py-20">
    <div class="flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="eyebrow">Fahrzeugauswahl</p>
        <h2 class="mt-3 text-3xl font-black tracking-tight text-primary sm:text-4xl">Aktuelle Design-Preview des Bestands</h2>
        <p class="mt-4 max-w-3xl leading-7 text-slate-600">Die Fahrzeugkarten zeigen die vorgesehene Darstellung. Die Daten bleiben bis zur offiziellen Source-/Parity-Verifikation ausdrücklich Preview-Daten.</p>
      </div>
      <a href="/fahrzeuge/" class="btn-premium-primary shrink-0">Gesamten Bestand ansehen</a>
    </div>

    <div class="preview-banner mt-7" role="status">
      Nicht autoritative Preview: keine Produktionsfreigabe des Fahrzeugbestands, solange Source-of-Truth und Portal-Parität nicht verifiziert sind.
    </div>

    <div class="mt-8 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
      {featured.map((vehicle) => (
        <article class="card-premium overflow-hidden rounded-2xl">
          <a href={`/fahrzeuge/${vehicle.id}`} class="group block">
            <img src={vehicle.mainImage} alt={vehicle.alt} class="aspect-[16/10] w-full object-cover" loading="lazy" width="720" height="450" />
            <div class="p-5 sm:p-6">
              <p class="text-xs font-black uppercase tracking-[0.16em] text-secondary">{vehicle.make}</p>
              <h3 class="mt-2 text-xl font-black leading-7 text-primary group-hover:underline">{vehicle.title}</h3>
              <dl class="mt-5 grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
                <div><dt class="text-slate-500">EZ</dt><dd class="font-bold text-primary">{vehicle.firstRegistration}</dd></div>
                <div><dt class="text-slate-500">Laufleistung</dt><dd class="font-bold text-primary">{vehicle.mileage}</dd></div>
                <div><dt class="text-slate-500">Leistung</dt><dd class="font-bold text-primary">{vehicle.power}</dd></div>
                <div><dt class="text-slate-500">Kraftstoff</dt><dd class="font-bold text-primary">{vehicle.fuel}</dd></div>
              </dl>
              <div class="mt-6 flex items-end justify-between gap-4 border-t border-slate-200 pt-5">
                <p class="text-2xl font-black text-primary">{vehicle.price}</p>
                <span class="text-sm font-extrabold text-secondary">Details ansehen →</span>
              </div>
            </div>
          </a>
        </article>
      ))}
    </div>
  </section>

  <section class="bg-white py-16 sm:py-20">
    <div class="section-wrap grid gap-6 lg:grid-cols-3">
      <article class="rounded-2xl bg-primary p-7 text-white sm:p-8">
        <p class="eyebrow">Autoankauf</p>
        <h2 class="mt-3 text-2xl font-black">Fahrzeug verkaufen</h2>
        <p class="mt-4 leading-7 text-white/75">Die wichtigsten Fahrzeugdaten übermitteln und die persönliche Bewertung vorbereiten.</p>
        <a href="/ankauf" class="btn-header-primary mt-7">Autoankauf anfragen</a>
      </article>
      <article class="card-premium rounded-2xl p-7 sm:p-8">
        <p class="eyebrow">Finanzierung</p>
        <h2 class="mt-3 text-2xl font-black text-primary">Monatsrate besprechen</h2>
        <p class="mt-4 leading-7 text-slate-600">Unverbindlich Finanzierungsmöglichkeiten zu einem Wunschfahrzeug anfragen — ohne Online-Kreditabschluss.</p>
        <a href="/finanzierung" class="btn-premium-primary mt-7">Finanzierung anfragen</a>
      </article>
      <article class="card-premium rounded-2xl p-7 sm:p-8">
        <p class="eyebrow">Kontakt</p>
        <h2 class="mt-3 text-2xl font-black text-primary">Persönlich weiterkommen</h2>
        <p class="mt-4 leading-7 text-slate-600">Fragen zum Fahrzeug, Besichtigung oder Rückruf direkt mit Fahrzeugbezug übermitteln.</p>
        <a href="/kontakt" class="btn-premium-secondary mt-7">Kontakt aufnehmen</a>
      </article>
    </div>
  </section>
</PublicLayout>
