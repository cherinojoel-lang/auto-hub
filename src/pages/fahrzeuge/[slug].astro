---
import PublicLayout from '@/layouts/PublicLayout.astro';
import { vehiclesData } from '@/data/vehiclesData.generated';

const slug = Astro.params.slug ?? '';
const vehicle = vehiclesData.find((item) => item.id === slug && item.status === 'available');

if (!vehicle) {
  Astro.response.status = 404;
}
---

<PublicLayout
  title={vehicle ? `${vehicle.make} ${vehicle.model} | Automobile Quick` : 'Fahrzeug nicht gefunden | Automobile Quick'}
  description={vehicle ? `${vehicle.title}. Fahrzeugdetail im nicht autoritativen Preview-Modus.` : 'Das angeforderte Fahrzeug wurde nicht gefunden.'}
  canonicalPath={`/fahrzeuge/${slug}`}
  noindex
>
  <section class="section-wrap py-8 pb-28 sm:py-10 md:pb-10 lg:py-14">
    {vehicle ? (
      <>
        <div class="preview-banner mb-7" role="status">
          Preview-Modus: Diese Fahrzeugdaten sind noch nicht als autoritative Live-Daten freigegeben.
        </div>

        <div class="grid gap-8 xl:grid-cols-[1.2fr_.8fr] xl:gap-12">
          <div>
            <div class="overflow-hidden rounded-2xl bg-white shadow-sm">
              <img src={vehicle.mainImage} alt={vehicle.alt} class="aspect-[16/10] w-full object-cover" width="1080" height="675" fetchpriority="high" />
            </div>

            {vehicle.gallery.length > 1 && (
              <div class="mt-4 grid grid-cols-3 gap-3 sm:grid-cols-4">
                {vehicle.gallery.slice(1, 9).map((image, index) => (
                  <img src={image} alt={`${vehicle.make} ${vehicle.model} Ansicht ${index + 2}`} class="aspect-[4/3] w-full rounded-xl bg-white object-cover" loading="lazy" width="360" height="270" />
                ))}
              </div>
            )}
          </div>

          <article class="self-start rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8 xl:sticky xl:top-28">
            <p class="eyebrow">{vehicle.make}</p>
            <h1 class="mt-3 text-3xl font-black leading-tight tracking-tight text-primary sm:text-4xl">{vehicle.title}</h1>
            <p class="mt-6 text-4xl font-black tracking-tight text-primary">{vehicle.price}</p>
            {vehicle.financing && <p class="mt-2 text-sm font-bold text-slate-500">{vehicle.financing}</p>}

            <dl class="mt-7 grid grid-cols-2 gap-x-6 gap-y-5 border-y border-slate-200 py-6 text-sm">
              <div><dt class="text-slate-500">Erstzulassung</dt><dd class="mt-1 font-extrabold text-primary">{vehicle.firstRegistration}</dd></div>
              <div><dt class="text-slate-500">Laufleistung</dt><dd class="mt-1 font-extrabold text-primary">{vehicle.mileage}</dd></div>
              <div><dt class="text-slate-500">Leistung</dt><dd class="mt-1 font-extrabold text-primary">{vehicle.power}</dd></div>
              <div><dt class="text-slate-500">Kraftstoff</dt><dd class="mt-1 font-extrabold text-primary">{vehicle.fuel}</dd></div>
            </dl>

            <div class="mt-7 grid gap-3 sm:grid-cols-2 xl:grid-cols-1 2xl:grid-cols-2">
              <a href={`/kontakt?vehicle_id=${encodeURIComponent(vehicle.id)}&topic=vehicle`} class="btn-premium-secondary">Besichtigung anfragen</a>
              <a href={`/finanzierung?vehicle_id=${encodeURIComponent(vehicle.id)}`} class="btn-premium-primary">Finanzierung anfragen</a>
            </div>
            <p class="mt-5 text-xs leading-5 text-slate-500">Eine Anfrage ist kein Kaufvertrag und keine verbindliche Reservierung.</p>
          </article>
        </div>

        <div class="mt-12 grid gap-8 lg:grid-cols-[1.1fr_.9fr]">
          <section class="card-premium rounded-2xl p-6 sm:p-8">
            <h2 class="text-2xl font-black text-primary">Fahrzeugbeschreibung</h2>
            <p class="mt-4 leading-8 text-slate-600">{vehicle.description ?? 'Weitere Ausstattungs- und Zustandsdetails werden erst aus der verifizierten Fahrzeugquelle für den Produktionsbestand übernommen.'}</p>
          </section>
          <section class="rounded-2xl bg-primary p-6 text-white sm:p-8">
            <h2 class="text-2xl font-black">Noch Fragen zum Fahrzeug?</h2>
            <p class="mt-4 leading-7 text-white/75">Fahrzeugbezogene Anfrage senden. Die spätere Produktionsstrecke verknüpft Fahrzeug-ID, Lead-ID, Quelle und Status durchgängig.</p>
            <a href={`/kontakt?vehicle_id=${encodeURIComponent(vehicle.id)}&topic=vehicle`} class="btn-header-primary mt-6">Zum Kontaktformular</a>
          </section>
        </div>

        <div class="mobile-vdp-bar fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 gap-2 border-t border-slate-200 bg-white/95 px-3 pt-3 shadow-[0_-8px_30px_rgba(10,22,40,.12)] backdrop-blur md:hidden">
          <a href={`/kontakt?vehicle_id=${encodeURIComponent(vehicle.id)}&topic=vehicle`} class="btn-premium-secondary">Anfragen</a>
          <a href={`/finanzierung?vehicle_id=${encodeURIComponent(vehicle.id)}`} class="btn-premium-primary">Finanzierung</a>
        </div>
      </>
    ) : (
      <div class="mx-auto max-w-2xl py-20 text-center">
        <p class="eyebrow">Automobile Quick</p>
        <h1 class="mt-3 text-3xl font-black text-primary">Fahrzeug nicht gefunden</h1>
        <p class="mt-4 text-slate-600">Der Eintrag ist nicht verfügbar oder wurde aus dem Preview-Bestand entfernt.</p>
        <a href="/fahrzeuge/" class="btn-premium-primary mt-8">Zur Fahrzeugübersicht</a>
      </div>
    )}
  </section>
</PublicLayout>
