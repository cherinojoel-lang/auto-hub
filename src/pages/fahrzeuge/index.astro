---
import PublicLayout from '@/layouts/PublicLayout.astro';
import { vehiclesData } from '@/data/vehiclesData.generated';

const previewVehicles = vehiclesData.filter((vehicle) => vehicle.status === 'available').slice(0, 12);
---

<PublicLayout
  title="Fahrzeuge | Automobile Quick"
  description="Gebrauchtwagen bei Automobile Quick vergleichen. Fahrzeugdaten im aktuellen Entwicklungsstand sind noch nicht als autoritative Live-Daten freigegeben."
  canonicalPath="/fahrzeuge/"
  noindex
>
  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-4 border-b border-slate-200 pb-8 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="text-sm font-bold uppercase tracking-[0.18em] text-secondary">Fahrzeugbestand</p>
        <h1 class="mt-2 text-4xl font-black tracking-tight text-primary">Fahrzeuge entdecken</h1>
        <p class="mt-3 max-w-3xl leading-7 text-slate-600">Diese Preview zeigt das künftige Layout. Die aktuell eingebundenen Fahrzeugdaten sind historischer Entwicklungsbestand und werden erst nach Source-/Parity-Verifikation für Produktion freigegeben.</p>
      </div>
      <a href="/kontakt" class="btn-premium-primary">Fahrzeugwunsch senden</a>
    </div>

    <div class="mt-8 rounded-xl border border-amber-300 bg-amber-50 px-5 py-4 text-sm leading-6 text-amber-950" role="status">
      Preview-Modus: Fahrzeugdaten sind <strong>nicht autoritativ</strong> und nicht für einen Produktions-Cutover freigegeben.
    </div>

    <div class="mt-8 grid gap-6 sm:grid-cols-2 xl:grid-cols-3">
      {previewVehicles.map((vehicle) => (
        <article class="card-premium overflow-hidden rounded-2xl bg-white">
          <a href={`/fahrzeuge/${vehicle.id}`} class="block">
            <img src={vehicle.mainImage} alt={vehicle.alt} class="aspect-[4/3] w-full object-cover" loading="lazy" />
            <div class="p-5">
              <p class="text-sm font-bold text-secondary">{vehicle.make}</p>
              <h2 class="mt-1 text-lg font-extrabold leading-6 text-primary">{vehicle.title}</h2>
              <dl class="mt-4 grid grid-cols-2 gap-3 text-sm text-slate-600">
                <div><dt class="font-semibold text-slate-500">EZ</dt><dd>{vehicle.firstRegistration}</dd></div>
                <div><dt class="font-semibold text-slate-500">Laufleistung</dt><dd>{vehicle.mileage}</dd></div>
                <div><dt class="font-semibold text-slate-500">Leistung</dt><dd>{vehicle.power}</dd></div>
                <div><dt class="font-semibold text-slate-500">Kraftstoff</dt><dd>{vehicle.fuel}</dd></div>
              </dl>
              <p class="mt-5 text-2xl font-black text-primary">{vehicle.price}</p>
            </div>
          </a>
        </article>
      ))}
    </div>
  </section>
</PublicLayout>
