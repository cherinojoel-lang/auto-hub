---
import PublicLayout from '@/layouts/PublicLayout.astro';
import { vehiclesData } from '@/data/vehiclesData.generated';

const previewVehicles = vehiclesData.filter((vehicle) => vehicle.status === 'available');
---

<PublicLayout
  title="Gebrauchtwagen in Iserlohn-Letmathe | Automobile Quick"
  description="Gebrauchtwagen bei Automobile Quick in Iserlohn-Letmathe vergleichen. Fahrzeugdaten im Entwicklungsstand sind noch nicht als autoritative Live-Daten freigegeben."
  canonicalPath="/fahrzeuge/"
  noindex
>
  <section class="bg-primary text-white">
    <div class="section-wrap py-12 sm:py-16 lg:py-20">
      <p class="eyebrow">Fahrzeugbestand</p>
      <div class="mt-4 grid gap-6 lg:grid-cols-[1fr_auto] lg:items-end">
        <div>
          <h1 class="max-w-4xl text-4xl font-black tracking-tight sm:text-5xl lg:text-6xl">Aktuelle Gebrauchtwagen in Iserlohn-Letmathe</h1>
          <p class="mt-5 max-w-3xl text-lg leading-8 text-white/78">Große Bilder, klare Preise und die wichtigsten Fahrzeugdaten auf einen Blick. Für die Produktionsfreigabe bleibt der Source-/Parity-Nachweis verbindlich.</p>
        </div>
        <a href="/kontakt?topic=vehicle-search" class="btn-header-primary">Fahrzeugwunsch senden</a>
      </div>
    </div>
  </section>

  <section class="section-wrap py-10 sm:py-12 lg:py-16">
    <div class="preview-banner" role="status">
      Preview-Modus: Die aktuell dargestellten Fahrzeuge stammen aus historischem Entwicklungsbestand. Sie bleiben <strong>noindex</strong> und dürfen nicht als aktueller Live-Bestand interpretiert werden.
    </div>

    <div class="mt-8 flex flex-col gap-3 border-b border-slate-200 pb-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="font-bold text-primary">{previewVehicles.length} Fahrzeuge in der Design-Preview</p>
      <p class="text-sm text-slate-500">Produktionsbestand erst nach offizieller Source-/Parity-Verifikation</p>
    </div>

    <div class="mt-8 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
      {previewVehicles.map((vehicle) => (
        <article class="card-premium overflow-hidden rounded-2xl">
          <a href={`/fahrzeuge/${vehicle.id}`} class="group block">
            <div class="relative overflow-hidden bg-slate-100">
              <img src={vehicle.mainImage} alt={vehicle.alt} class="aspect-[16/10] w-full object-cover transition duration-300 group-hover:scale-[1.01]" loading="lazy" width="720" height="450" />
              {vehicle.isNew && <span class="absolute left-4 top-4 rounded-full bg-primary px-3 py-1.5 text-xs font-black text-white">Neu in der Preview</span>}
            </div>
            <div class="p-5 sm:p-6">
              <p class="text-xs font-black uppercase tracking-[0.16em] text-secondary">{vehicle.make}</p>
              <h2 class="mt-2 min-h-[3.5rem] text-xl font-black leading-7 text-primary group-hover:underline">{vehicle.title}</h2>

              <p class="mt-5 text-3xl font-black tracking-tight text-primary">{vehicle.price}</p>
              {vehicle.financing && <p class="mt-1 text-sm font-bold text-slate-500">{vehicle.financing}</p>}

              <dl class="mt-5 grid grid-cols-2 gap-x-4 gap-y-4 border-y border-slate-200 py-5 text-sm">
                <div><dt class="text-slate-500">Erstzulassung</dt><dd class="mt-1 font-extrabold text-primary">{vehicle.firstRegistration}</dd></div>
                <div><dt class="text-slate-500">Laufleistung</dt><dd class="mt-1 font-extrabold text-primary">{vehicle.mileage}</dd></div>
                <div><dt class="text-slate-500">Leistung</dt><dd class="mt-1 font-extrabold text-primary">{vehicle.power}</dd></div>
                <div><dt class="text-slate-500">Kraftstoff</dt><dd class="mt-1 font-extrabold text-primary">{vehicle.fuel}</dd></div>
              </dl>

              <div class="mt-5 grid grid-cols-2 gap-3">
                <span class="btn-premium-primary">Details</span>
                <span class="btn-premium-secondary">Anfragen</span>
              </div>
            </div>
          </a>
        </article>
      ))}
    </div>
  </section>
</PublicLayout>
