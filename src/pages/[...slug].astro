---
import { SEO } from '@wix/seo/components';
import { loadSEOTagsServiceConfig } from '@wix/seo/services';
import { Head } from "@/components/Head";
import AppRouter from "@/components/Router";
import "@wix/wix-vibe-plugins/plugins-vars.css";
import "@wix/wix-vibe-plugins/plugins-theme.css";
import "@/styles/global.css";

let seoTagsServiceConfig = null;
try {
  const loadSeoWithTimeout = Promise.race([
    loadSEOTagsServiceConfig({
      pageUrl: Astro.url.href,
      itemData: {
        pageName: 'Home',
      },
    }),
    new Promise((_, reject) => setTimeout(() => reject(new Error('SEO service timeout')), 3000))
  ]);
  seoTagsServiceConfig = await loadSeoWithTimeout;
} catch (error) {
  console.error('Error loading SEO tags config:', error);
}
---

<html lang="de" class="w-full h-full">
  <head>
        <!-- Google Consent Mode v2 setup -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}

      // Default to denied for GDPR compliance
      gtag('consent', 'default', {
        'analytics_storage': 'denied',
        'ad_storage': 'denied',
        'ad_user_data': 'denied',
        'ad_personalization': 'denied',
        'wait_for_update': 500
      });

      // If user previously accepted, update immediately
      try {
        if (localStorage.getItem('aq_cookie_consent_v1') === 'accepted') {
          gtag('consent', 'update', {
            'analytics_storage': 'granted',
            'ad_storage': 'granted',
            'ad_user_data': 'granted',
            'ad_personalization': 'granted'
          });
        }
      } catch (e) {}
    </script>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-VXQH8F5D33" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-VXQH8F5D33', { send_page_view: false }); // Prevent double tracking since React router tracker will fire on mount
    </script>

    <Head />
    {seoTagsServiceConfig && <SEO.Tags seoTagsServiceConfig={seoTagsServiceConfig} slot="seo-tags" />}
  </head>
  <body class="w-full h-full">
    <div id="root" class="w-full h-full">
      <AppRouter client:only="react" />
    </div>
  </body>
</html>
