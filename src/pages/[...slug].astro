---
import PublicLayout from '@/layouts/PublicLayout.astro';

Astro.response.status = 404;
---

<PublicLayout
  title="Seite nicht gefunden | Automobile Quick"
  description="Die angeforderte Seite wurde nicht gefunden."
  canonicalPath={Astro.url.pathname}
  noindex
>
  <section class="section-wrap py-20 text-center sm:py-28">
    <p class="eyebrow">404</p>
    <h1 class="mt-4 text-4xl font-black tracking-tight text-primary sm:text-5xl">Diese Seite gibt es nicht.</h1>
    <p class="mx-auto mt-5 max-w-2xl text-lg leading-8 text-slate-600">Nutzen Sie den Fahrzeugbestand oder die Kontaktseite, um direkt weiterzukommen.</p>
    <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
      <a href="/fahrzeuge/" class="btn-premium-primary">Fahrzeuge ansehen</a>
      <a href="/kontakt" class="btn-premium-secondary">Kontakt aufnehmen</a>
    </div>
  </section>
</PublicLayout>
