---
import { Head } from "@/components/Head";
import AppRouter from "@/components/Router";
import "@/styles/global.css";
import { shouldNoindexPreview } from '@/domain/preview';

const hostname = Astro.url.hostname;
const isPreview = shouldNoindexPreview(hostname);
const pathname = Astro.url.pathname;
const canonicalUrl = Astro.url.href;

// Handle legacy/new compatibility redirects securely
if (pathname === '/fahrzeuge' || pathname === '/fahrzeuge/') {
  return Astro.redirect('/fahrzeugbestand', 301);
}
if (pathname === '/ankauf' || pathname === '/ankauf/') {
  return Astro.redirect('/autoankauf', 301);
}

// Check for /fahrzeuge/:slug
const fahrzeugeMatch = pathname.match(/^\/fahrzeuge\/([^/]+)$/);
if (fahrzeugeMatch) {
  const fullSlug = fahrzeugeMatch[1];
  // extract ID from the slug (e.g. 17_fiat-500-hybrid-2024 -> 17)
  const idMatch = fullSlug.match(/^(\d+)_/);
  if (idMatch) {
    return Astro.redirect(`/fahrzeugdetail/${idMatch[1]}`, 301);
  }
}
---

<html lang="de" class="w-full h-full">
  <head>
    <Head canonicalUrl={canonicalUrl} isPreview={isPreview} />
  </head>
  <body class="w-full h-full bg-background text-foreground overflow-x-hidden">
    <div id="root" class="w-full h-full flex flex-col min-h-screen">
      <AppRouter client:only="react" />
    </div>
  </body>
</html>
